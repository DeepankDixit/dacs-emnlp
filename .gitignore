# =============================================================================
# DACS Research Project — .gitignore
# =============================================================================
# Track: code/ only
# Ignore: large model outputs, results, images, secrets

# ── Large model outputs (never commit — tens of GB) ──────────────────────────
outputs/
results/
*.bin
*.safetensors
*.pt
*.pth

# ── HuggingFace cache ─────────────────────────────────────────────────────────
.cache/
__pycache__/
*.pyc
*.pyo

# ── Secrets and tokens ────────────────────────────────────────────────────────
.env
*.env
secrets.txt
hf_token.txt

# ── OS and editor clutter ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── Documentation (large docx/pptx/md files — tracked separately if needed) ──
documentation/
images/

# ── Jupyter notebooks (too noisy for git — use scripts) ─────────────────────
*.ipynb
.ipynb_checkpoints/

# ── Eval harness clones (install fresh on each GPU instance) ─────────────────
PurpleLlama/
MedQA/

# ── Paper build artifacts (track LaTeX source, not compiled output) ───────────
paper/*.pdf
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/*.log

# ── Temporary files ───────────────────────────────────────────────────────────
*.tmp
/tmp/
data/cybersec_sft_train.jsonl

# ── Local-only working-copy notes (not part of the repo) ────────────────────
CLAUDE.md
HANDOFF.md
quantization explainer/
DACS_Pre-Submission_Review.md
# ── macOS resource-fork sidecar files (AppleDouble) ──────────────────────────
._*
**/._*

# ── Stale figure (replaced by fig6_per_layer_distribution.pdf) ───────────────
paper/fig6_kl_vs_regression.pdf
